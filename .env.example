# Copy this file to .env and fill in ONE of the AI keys.
# Without a key, Riptide still works in "rules-only" mode (no screenshot reading).

# Option A — Claude (recommended). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is fast and cheap; claude-sonnet-4-5 is smarter but slower.
ANTHROPIC_MODEL=claude-haiku-4-5

# Option B — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option C — Google Gemini (free tier, no credit card). Get a key at https://aistudio.google.com/apikey
# On the free tier Google may use what's sent to improve its models.
GEMINI_API_KEY=
# Leave blank to use gemini-flash-latest; Riptide picks another Flash model automatically if that one isn't available.
GEMINI_MODEL=

# Password for approving community reports on the Dashboard page.
ADMIN_KEY=riptide-demo

# Port for the API server (Render/other hosts set this automatically).
PORT=3001

# Set to true on hosts that wipe files (e.g. Render free plan) to reload labeled sample
# dashboard data every time the server starts with an empty store.
SEED_SAMPLE_DATA=false
